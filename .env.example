# ============ LLM ============
# deepseek | mock
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
# 在这里填入你自己的 DeepSeek API Key（不要把 .env 提交到 git）
LLM_API_KEY=sk-your-key-here
# 旧模型名 deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用
LLM_MODEL=deepseek-v4-flash
# enabled | disabled | unset
LLM_THINKING=disabled
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ============ Embedding ============
# hash：离线确定性词法向量，无需额外 Key（默认，保证开箱即用）
# openai_compatible：任意 OpenAI 兼容 embedding 接口，例如 SiliconFlow BAAI/bge-m3
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=512
EMBEDDING_TIMEOUT_SECONDS=30

# ============ App ============
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
AUTO_SEED=true
# 管理端点（上传/删除/重建索引）令牌；留空表示本地演示不校验
ADMIN_TOKEN=
# 演示客户；订单表里只有该客户的订单可以查询
DEMO_CUSTOMER_ID=C001
# 公网演示访问密码（HTTP Basic）；留空不启用
ACCESS_USERNAME=demo
ACCESS_PASSWORD=

# ============ Mock ITSM（第三方工单系统） ============
# 留空时默认使用 http://127.0.0.1:${APP_PORT}
ITSM_BASE_URL=
ITSM_API_KEY=demo-itsm-key
ITSM_TIMEOUT_SECONDS=10

# ============ Limits ============
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=20
CHUNK_SIZE=420
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=6
MAX_AGENT_STEPS=6
MAX_TOOL_CALLS_PER_STEP=3
MAX_TICKETS_PER_SESSION=3
HISTORY_MESSAGES=8
SESSION_MAX_CHARS=2000
MAX_CONCURRENT_STREAMS=4
SSE_HEARTBEAT_SECONDS=15
